      "temperature": 0.7,
      "maxTokens": 1200,
      "tools": [
        "get_time",
        "calc",
        "remember",
        "recall",
        "send_message",
        "list_contacts",
        "list_sessions"
      ],
      "keywords": [],
      "channels": [
        "web",
        "wechat",
        "wecom",
        "qq",
        "onebot"
      ],
      "enabled": true,
      "greeting": "你好，我是你的 AI 助手，有什么可以帮你？"
    }
  ],
